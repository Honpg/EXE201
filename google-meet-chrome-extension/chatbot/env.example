# Environment Configuration for Ocean AI Extension

# Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Configuration
BACKEND_URL=http://localhost:3000

# Chatbot Settings (optional)
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_CONTEXT=1000
CHATBOT_MAX_RESPONSE=200
CHATBOT_MAX_HISTORY=50

# Instructions:
# 1. Copy this file to 'env.js'
# 2. Replace 'your_gemini_api_key_here' with your actual API key
# 3. Customize other settings if needed
# 4. DO NOT commit env.js to version control
